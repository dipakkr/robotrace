{
  "name": "teachtrace-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/build-trace-viewer.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env.local server/index.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs",
    "test": "tsx --test src/sim/*.test.ts src/data/*.test.ts && node --test server/*.test.mjs scripts/*.test.mjs",
    "demo:start": "node scripts/demo.mjs start",
    "demo:status": "node scripts/demo.mjs status",
    "demo:restart-api": "node scripts/demo.mjs restart-api",
    "demo:stop": "node scripts/demo.mjs stop"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "agora-rtc-sdk-ng": "^4.24.1",
    "agora-token": "^2.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
