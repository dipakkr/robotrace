# Copy to .env.local. These values are loaded by the LOCAL NODE SERVER only.
# Never prefix provider secrets with VITE_ or paste credentials into the UI.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
MURF_API_KEY=
LLM_API_KEY=

# Required for Agora's servers to call the simulator tools. Use a public HTTPS
# tunnel to localhost:8788 while developing; a loopback URL will not work.
PUBLIC_API_BASE_URL=

# Optional Basic-auth override for Agora REST. Leave both empty to use the
# default short-lived token signed with the App Certificate. Set both together.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Optional settings. The managed ASR requires Conversational AI enabled in Agora.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
MURF_VOICE_ID=en-US-matthew
API_PORT=8787
API_TOOLS_PORT=8788
FRONTEND_ORIGIN=http://localhost:5189
